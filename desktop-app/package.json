{
  "name": "school-management-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "better-sqlite3": "11.8.1",
    "lucide-react": "^0.468.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "typescript": "5.7.3",
    "vite": "6.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.6",
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.13.4",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "concurrently": "9.1.2",
    "electron": "35.0.0",
    "electron-builder": "26.0.12",
    "node-gyp": "^12.2.0",
    "tsx": "4.19.3",
    "wait-on": "8.0.2"
  },
  "build": {
    "appId": "com.northstar.schoolmanagement",
    "productName": "OlufunmilayoSMS",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "build/icon.ico", "node_modules/**/*", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "asarUnpack": ["node_modules/better-sqlite3/**/*"]
  },
  "allowScripts": {
    "electron@35.0.0": true,
    "better-sqlite3@11.8.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.24.2": true,
    "electron-winstaller@5.4.0": true
  }
}
